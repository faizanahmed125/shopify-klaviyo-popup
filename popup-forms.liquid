<!-- POPUP 1: Welcome -->
<div class="kl-overlay active" id="kl-welcome-overlay">
  <div class="kl-box" role="dialog" aria-modal="true" aria-labelledby="kl-welcome-title">
    <button class="kl-close" type="button" onclick="closeWelcome()" aria-label="Close welcome popup">×</button>

    <div id="kl-welcome-form">
      <h2 id="kl-welcome-title">👋 Welcome!</h2>
      <p>Stay in the loop — enter your details below.</p>
      <input type="email" id="kl-email-1" placeholder="Your email address" autocomplete="email" />
      <span class="kl-error" id="kl-err-1" aria-live="polite"></span>
      <input type="tel" id="kl-phone-1" placeholder="Phone number (e.g. +15551234567)" autocomplete="tel" />
      <button class="kl-btn" type="button" id="kl-btn-welcome" onclick="submitWelcome()">Subscribe</button>
    </div>

    <div id="kl-welcome-thanks" class="kl-thanks" style="display:none">
      <h2>🎉 Thank you!</h2>
      <p>You're all signed up. We'll be in touch soon!</p>
      <button class="kl-btn" type="button" onclick="closeWelcome()" style="margin-top:20px">Close</button>
    </div>
  </div>
</div>

<!-- POPUP 2: Children question -->
<div class="kl-overlay" id="kl-children-bar">
  <div class="kl-box" role="dialog" aria-modal="true" aria-labelledby="kl-children-title" style="text-align:center;">
    <button class="kl-close" type="button" onclick="closeBar()" aria-label="Close question">×</button>
    <h2 id="kl-children-title">👶 Quick Question</h2>
    <p>Do you have children? We'd love to send birthday surprises for your little ones!</p>
    <select id="kl-children-answer" aria-label="Number of children" onchange="handleChildrenAnswer(this.value)"
      style="width:100%; padding:11px 14px; border:1px solid #ddd; border-radius:8px;
             font-size:15px; cursor:pointer; background:#fff; outline:none;
             appearance:none; -webkit-appearance:none;">
      <option value="">— Please select —</option>
      <option value="no">No, I don't have children</option>
      <option value="1">Yes — 1 child</option>
      <option value="2">Yes — 2 children</option>
      <option value="3">Yes — 3 children</option>
      <option value="4">Yes — 4 children</option>
    </select>
  </div>
</div>

<!-- POPUP 3: Children birthdays -->
<div class="kl-overlay" id="kl-birthday-overlay">
  <div class="kl-box" role="dialog" aria-modal="true" aria-labelledby="kl-birthday-title">
    <button class="kl-close" type="button" onclick="closeBirthdayPopup()" aria-label="Close birthday popup">×</button>

    <div id="kl-birthday-form">
      <h2 id="kl-birthday-title">🎂 Children's Birthdays</h2>
      <p>We'll send special birthday surprises for your little ones!</p>
      <input type="email" id="kl-email-2" placeholder="Confirm your email address" autocomplete="email" />
      <span class="kl-error" id="kl-err-2" aria-live="polite"></span>
      <div id="kl-birthday-fields"></div>
      <button class="kl-btn" type="button" id="kl-btn-bday" onclick="submitBirthdays()">Save Birthday Details</button>
    </div>

    <div id="kl-birthday-thanks" class="kl-thanks" style="display:none">
      <h2>🥳 All Saved!</h2>
      <p>We'll remember their birthdays — stay tuned for surprises!</p>
      <button class="kl-btn" type="button" onclick="closeBirthdayPopup()" style="margin-top:20px">Done</button>
    </div>
  </div>
</div>
